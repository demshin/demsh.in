source 'https://rubygems.org'

# Pin standalone Jekyll for the custom GitHub Pages workflow.
# Keep explicit dependencies instead of the broad github-pages metagem.
gem 'jekyll', '~> 4.4.1'
gem 'jekyll-theme-minimal', '~> 0.2.0'
gem 'kramdown-parser-gfm', '~> 1.1'
gem 'webrick', '~> 1.9'

# Standard-library gems needed by the dependency set on recent Ruby versions.
gem 'base64'
gem 'bigdecimal'
gem 'logger'

group :jekyll_plugins do
  gem 'jekyll-default-layout', '~> 0.2'
  gem 'jekyll-optional-front-matter', '~> 0.3'
  gem 'jekyll-paginate', '~> 1.1'
  gem 'jekyll-readme-index', '~> 0.5'
  gem 'jekyll-redirect-from', '~> 0.17'
  gem 'jekyll-relative-links', '~> 0.9'
  gem 'jekyll-sitemap', '~> 1.4'
  gem 'jekyll-titles-from-headings', '~> 0.6'
end

