source 'https://rubygems.org'

# Match the GitHub Pages Jekyll version without its unused plugin dependencies.
# github-pages pins jekyll-remote-theme to a version requiring vulnerable rubyzip < 3.
gem 'jekyll', '~> 3.10.0'
gem 'jekyll-theme-minimal', '~> 0.2.0'
gem 'kramdown-parser-gfm', '~> 1.1'
gem 'webrick', '~> 1.9'

# Jekyll 3 dependencies extracted from the standard library in recent Ruby versions.
gem 'base64'
gem 'bigdecimal'
gem 'logger'

group :jekyll_plugins do
  gem 'jekyll-default-layout', '~> 0.2'
  gem 'jekyll-optional-front-matter', '~> 0.3'
  gem 'jekyll-paginate', '~> 1.1'
  gem 'jekyll-readme-index', '~> 0.3'
  gem 'jekyll-redirect-from', '~> 0.17'
  gem 'jekyll-relative-links', '~> 0.6'
  gem 'jekyll-sitemap', '~> 1.4'
  gem 'jekyll-titles-from-headings', '~> 0.5'
end

